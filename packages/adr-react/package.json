{
  "name": "@etiennea20/adr-react",
  "version": "0.0.0",
  "description": "Composants et hooks React catégorisés : affichage de contenu, formulaires, interface, routing, CRUD, fetch, filtres.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./fetch": {
      "import": {
        "types": "./dist/fetch/index.d.ts",
        "default": "./dist/fetch/index.js"
      },
      "require": {
        "types": "./dist/fetch/index.d.cts",
        "default": "./dist/fetch/index.cjs"
      }
    },
    "./routing": {
      "import": {
        "types": "./dist/routing/index.d.ts",
        "default": "./dist/routing/index.js"
      },
      "require": {
        "types": "./dist/routing/index.d.cts",
        "default": "./dist/routing/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5",
    "axios": ">=1",
    "react": ">=18",
    "react-dom": ">=18",
    "react-router": ">=7"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@etiennea20/config": "workspace:*",
    "@tanstack/react-query": "^5.105.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "catalog:",
    "axios": "^1.21.0",
    "eslint": "catalog:",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "tsup": "^9.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EtienneA20/adr-package.git",
    "directory": "packages/adr-react"
  }
}
