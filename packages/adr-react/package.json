{
  "name": "@etiennea20/adr-react",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./fetch": {
      "import": {
        "types": "./dist/fetch/index.d.ts",
        "default": "./dist/fetch/index.js"
      },
      "require": {
        "types": "./dist/fetch/index.d.cts",
        "default": "./dist/fetch/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.105.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axios": "^1.21.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "tsup": "^9.0.0",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5",
    "axios": ">=1",
    "react": ">=18",
    "react-dom": ">=18",
    "react-router": ">=7"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EtienneA20/adr-package.git",
    "directory": "packages/adr-react"
  }
}
