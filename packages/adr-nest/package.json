{
  "name": "@etiennea20/adr-nest",
  "version": "0.1.0",
  "description": "Utilitaires NestJS : méthodes avancées, gestion des droits, filtrage avancé, export Excel et JSON.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "adr-nest-skills": "./bin/install-skills.mjs"
  },
  "files": [
    "dist",
    "skills",
    "bin"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && pnpm run build:skills",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "build:skills": "node ../../scripts/install-skills.mjs --package adr-nest --skills-dir skills"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@etiennea20/config": "workspace:*",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/testing": "^12.3.2",
    "@swc/core": "^1.16.20",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "catalog:",
    "unplugin-swc": "^2.0.0",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EtienneA20/adr-package.git",
    "directory": "packages/adr-nest"
  }
}
